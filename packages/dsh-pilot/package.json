{
  "name": "dsh-pilot",
  "version": "0.1.0",
  "description": "Pilot product bundle for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-sidebar"], "external": ["react", "@deepseek-ai/dsh-client-ui-slots"] } },
  "engines": { "dsh": "0.2.1-rc.5" },
  "scripts": { "build": "node ../../scripts/build.mjs --bundle-only" }
}
