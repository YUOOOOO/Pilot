{
  "name": "pilot-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/desktop", "packages/dsh-pilot"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron apps/desktop",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dist:win": "npm run build && npm run prepare:runtime && electron-builder --config apps/desktop/electron-builder.yml --win --x64",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "electron": "39.2.7",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-web-app": "0.2.1-rc.5"
  }
}
